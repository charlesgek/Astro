---
export const prerender = false;

import { getCollection, render } from "astro:content";
import { readingTime } from "@lib/utils";
import PageLayout from "@layouts/PageLayout.astro";
import TopLayout from "@layouts/TopLayout.astro";
import BottomLayout from "@layouts/BottomLayout.astro";
import ArticleTopLayout from "@layouts/ArticleTopLayout.astro";
import ArticleBottomLayout from "@layouts/ArticleBottomLayout.astro";

const { slug } = Astro.params;

if (!slug) {
  return Astro.rewrite("/404");
}

const projects = await getCollection("projects");
const project = projects.find((p) => p.id === slug);

if (!project) {
  return Astro.rewrite("/404");
}

const { title, summary } = project.data;
const readingTimeText = readingTime(project.body ?? "");
---

<PageLayout title={title} description={summary}>
  <TopLayout>
    <div class="animate">
      <ArticleTopLayout entry={project} readingTimeText={readingTimeText} />
    </div>
  </TopLayout>
  <BottomLayout>
    <div class="animate">
      <ArticleBottomLayout entry={project} />
    </div>
  </BottomLayout>
</PageLayout>